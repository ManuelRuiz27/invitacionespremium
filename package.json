{
  "name": "invitacionespremium",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de InvitacionesPremium",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "staging:deploy": "pnpm --filter @invitaciones/api staging:deploy",
    "staging:migrate": "pnpm --filter @invitaciones/api staging:migrate",
    "staging:seed": "pnpm --filter @invitaciones/api staging:seed",
    "staging:verify-secrets": "pnpm --filter @invitaciones/api staging:verify-secrets",
    "staging:smoke": "pnpm --filter @invitaciones/api staging:smoke",
    "staging:backup": "pnpm --filter @invitaciones/api staging:backup",
    "staging:restore": "pnpm --filter @invitaciones/api staging:restore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
