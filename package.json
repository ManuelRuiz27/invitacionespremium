{
  "name": "invitacionespremium",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de InvitacionesPremium",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e:managed": "node scripts/run-managed-m01-e2e.mjs",
    "test:e2e:access-control": "node scripts/run-access-control-e2e.mjs",
    "test:e2e:public-catalog": "node scripts/run-access-control-e2e.mjs --public-catalog",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "qa:quick": "node scripts/run-qa.mjs quick",
    "qa:focused": "node scripts/run-qa.mjs focused",
    "qa:full": "node scripts/run-qa.mjs full",
    "qa:tooling:test": "eslint scripts/run-qa.mjs scripts/qa-selection.mjs scripts/qa-selection.test.mjs && node --test scripts/qa-selection.test.mjs scripts/access-control-integration-selection.test.mjs scripts/qa-redaction.test.mjs",
    "local:seed": "pnpm --filter @invitaciones/api local:seed",
    "local:smoke": "node scripts/smoke-local.mjs",
    "product-proof:capture": "node scripts/capture-landing-product-proof.mjs",
    "landing:verify": "node scripts/verify-landing.mjs",
    "staging:deploy": "pnpm --filter @invitaciones/api staging:deploy",
    "staging:migrate": "pnpm --filter @invitaciones/api staging:migrate",
    "staging:seed": "pnpm --filter @invitaciones/api staging:seed",
    "staging:verify-secrets": "pnpm --filter @invitaciones/api staging:verify-secrets",
    "staging:smoke": "pnpm --filter @invitaciones/api staging:smoke",
    "staging:backup": "pnpm --filter @invitaciones/api staging:backup",
    "staging:restore": "pnpm --filter @invitaciones/api staging:restore",
    "access-control-guide:capture": "node scripts/run-access-control-e2e.mjs --guide && node scripts/access-control-guide/render.mjs && node scripts/access-control-guide/verify.mjs",
    "access-control-guide:render": "node scripts/access-control-guide/render.mjs",
    "access-control-guide:verify": "node scripts/access-control-guide/verify.mjs",
    "access-control-guide:test": "tsc -p tsconfig.access-control-guide.json && node --test scripts/access-control-guide/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.0",
    "eslint": "^10.7.0",
    "gifenc": "^1.0.3",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
