NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invitacionespremium
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
PHONE_DEFAULT_REGION=MX
CONTACT_IMPORT_PREVIEW_TTL_SECONDS=1800
FILE_STORAGE_LOCAL_ROOT=var/file-assets
FILE_UPLOAD_MAX_BYTES=10485760
FILE_IMAGE_MAX_PIXELS=40000000
FILE_ORPHAN_RETENTION_SECONDS=86400
# Production: required; replace with a unique cryptographically random secret of at least 32 bytes.
INVITATION_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Production: required; use an HTTPS public URL with a path and no credentials, query, fragment, or loopback host.
PUBLIC_INVITATION_BASE_URL=http://localhost:5173/invitacion
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
LOG_LEVEL=debug
SWAGGER_ENABLED=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=ip_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/v1
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change-me-at-least-12-chars
