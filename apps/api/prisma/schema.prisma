generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  STAFF_TOKEN
  PUBLIC_TOKEN
  SYSTEM

  @@map("audit_actor_type")
}

enum ClientType {
  PLANNER
  ORGANIZATION

  @@map("client_type")
}

enum ClientStatus {
  ACTIVE
  SUSPENDED

  @@map("client_status")
}

enum ServiceCode {
  FLIPBOOK
  FLYER
  PHYSICAL_QR
  DEMO

  @@map("service_code")
}

enum PromotionScope {
  CREDIT_PURCHASE
  EVENT_ACTIVATION

  @@map("promotion_scope")
}

enum LedgerMovementType {
  CREDIT_PURCHASE
  MANUAL_CREDIT_GRANT
  EVENT_ACTIVATION_CHARGE
  CREDIT_LINE_USAGE
  DEBT_PAYMENT
  EVENT_CREDIT_REFUND
  LEDGER_REVERSAL
  PROMOTION_DISCOUNT

  @@map("ledger_movement_type")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

enum PaymentProvider {
  MANUAL

  @@map("payment_provider")
}

enum CreditLineStatus {
  ACTIVE
  SUSPENDED

  @@map("credit_line_status")
}

enum EventSocialType {
  WEDDING     @map("wedding")
  QUINCEANERA @map("quinceanera")
  CORPORATE   @map("corporate")
  BIRTHDAY    @map("birthday")
  OTHER       @map("other")

  @@map("event_social_type")
}

enum EventStatus {
  DRAFT             @map("draft")
  CONFIGURED        @map("configured")
  READY_TO_ACTIVATE @map("ready_to_activate")
  ACTIVE            @map("active")
  EVENT_DAY         @map("event_day")
  CLOSED            @map("closed")
  ALBUM_PUBLISHED   @map("album_published")
  ARCHIVED          @map("archived")
  CANCELLED         @map("cancelled")

  @@map("event_status")
}

enum EventStateAction {
  CLOSE     @map("close")
  REOPEN    @map("reopen")
  CANCEL    @map("cancel")
  ARCHIVE   @map("archive")
  EVENT_DAY @map("event_day")

  @@map("event_state_action")
}

enum InvitationMode {
  INDIVIDUAL
  FAMILY_NOMINAL

  @@map("invitation_mode")
}

enum InvitationResponseStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("invitation_response_status")
}

enum AssistantResponseStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("assistant_response_status")
}

enum FileAssetOwnerType {
  FLYER
  FLIPBOOK_PAGE
  FLOORPLAN
  ALBUM_PHOTO
  GENERATED_REPORT
  INVITATION
  PHYSICAL_PASS

  @@map("file_asset_owner_type")
}

enum FileAssetType {
  FLYER_INITIAL_IMAGE
  FLYER_QR_IMAGE
  FLIPBOOK_PAGE_IMAGE
  FLOORPLAN_IMAGE
  ALBUM_PHOTO_IMAGE
  GENERATED_REPORT_PDF
  INVITATION_QR_SVG
  PHYSICAL_PASS_QR_SVG

  @@map("file_asset_type")
}

enum FileAssetStatus {
  UPLOADING
  READY
  FAILED
  HIDDEN
  DELETED

  @@map("file_asset_status")
}

enum InvitationDesignType {
  FLYER
  FLIPBOOK

  @@map("invitation_design_type")
}

enum HotspotVisualOwnerType {
  FLYER
  FLIPBOOK_PAGE

  @@map("hotspot_visual_owner_type")
}

enum HotspotAction {
  RSVP
  LOCATION
  GIFT_REGISTRY
  QR_AREA
  EXTERNAL_LINK

  @@map("hotspot_action")
}

enum StorageProvider {
  LOCAL

  @@map("storage_provider")
}

enum UserRole {
  PLATFORM_ADMIN
  INDEPENDENT_PLANNER
  ORGANIZATION_ADMIN
  ORGANIZATION_PLANNER

  @@map("user_role")
}

model AuditLog {
  id               String         @id @default(uuid()) @db.Uuid
  actorType        AuditActorType @map("actor_type")
  actorId          String?        @map("actor_id") @db.Uuid
  actorFingerprint String?        @map("actor_fingerprint") @db.Char(64)
  clientId         String?        @map("client_id") @db.Uuid
  eventId          String?        @map("event_id") @db.Uuid
  resourceType     String         @map("resource_type") @db.VarChar(100)
  resourceId       String?        @map("resource_id") @db.Uuid
  action           String         @db.VarChar(120)
  beforeData       Json?          @map("before_data")
  afterData        Json?          @map("after_data")
  metadata         Json?
  operationId      String?        @map("operation_id") @db.Uuid
  occurredAt       DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([clientId, occurredAt])
  @@index([eventId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([operationId])
  @@map("audit_log")
}

model Client {
  id               String          @id @default(uuid()) @db.Uuid
  type             ClientType
  name             String          @db.VarChar(160)
  status           ClientStatus    @default(ACTIVE)
  suspendedAt      DateTime?       @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?         @map("suspension_reason") @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  users            User[]
  promotions       Promotion[]
  financeBalance   FinanceBalance?
  creditLine       CreditLine?
  ledgerEntries    LedgerEntry[]
  payments         Payment[]
  receipts         Receipt[]
  events           Event[]
  fileAssets       FileAsset[]

  @@index([type, status, deletedAt])
  @@index([status, deletedAt])
  @@map("client")
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  email                    String                 @unique @db.VarChar(320)
  passwordHash             String                 @map("password_hash") @db.Text
  role                     UserRole
  clientId                 String?                @map("client_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(6)
  client                   Client?                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions                 AuthSession[]
  ledgerEntries            LedgerEntry[]
  payments                 Payment[]
  createdEvents            Event[]                @relation("EventCreator")
  activatedEvents          Event[]                @relation("EventActivator")
  contactImportPreviews    ContactImportPreview[]
  cancelledInvitations     Invitation[]           @relation("InvitationCanceller")
  createdFileAssets        FileAsset[]            @relation("FileAssetCreator")
  confirmationClosedEvents Event[]                @relation("EventConfirmationCloser")
  createdStaffTokens       StaffToken[]           @relation("StaffTokenCreator")

  @@index([clientId])
  @@index([role, deletedAt])
  @@map("app_user")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_session")
}

model Service {
  id              String         @id @default(uuid()) @db.Uuid
  code            ServiceCode    @unique
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  prices          ServicePrice[]
  promotions      Promotion[]
  events          Event[]        @relation("EventConfiguredService")
  activatedEvents Event[]        @relation("EventActivatedService")

  @@index([isActive, code])
  @@map("service")
}

model ServicePrice {
  id              String     @id @default(uuid()) @db.Uuid
  serviceId       String     @map("service_id") @db.Uuid
  clientType      ClientType @map("client_type")
  credits         Int
  validFrom       DateTime   @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime?  @map("valid_until") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  service         Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  activatedEvents Event[]

  @@unique([serviceId, clientType, validFrom])
  @@index([clientType, validFrom, validUntil])
  @@index([serviceId, clientType, validFrom])
  @@map("service_price")
}

model Promotion {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(160)
  scope          PromotionScope
  clientId       String?        @map("client_id") @db.Uuid
  clientType     ClientType?    @map("client_type")
  serviceId      String?        @map("service_id") @db.Uuid
  validFrom      DateTime       @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime?      @map("valid_until") @db.Timestamptz(6)
  isActive       Boolean        @default(false) @map("is_active")
  allowsStacking Boolean        @default(false) @map("allows_stacking")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  ledgerEntries  LedgerEntry[]

  @@index([isActive, scope, validFrom, validUntil])
  @@index([clientId, isActive])
  @@index([clientType, isActive])
  @@index([serviceId, isActive])
  @@map("promotion")
}

model FinanceBalance {
  clientId           String   @id @map("client_id") @db.Uuid
  purchasedCredits   Int      @default(0) @map("purchased_credits")
  creditLineLimit    Int      @default(0) @map("credit_line_limit")
  creditLineUsed     Int      @default(0) @map("credit_line_used")
  debtCredits        Int      @default(0) @map("debt_credits")
  debtMxnCents       BigInt   @default(0) @map("debt_mxn_cents")
  lastLedgerSequence BigInt?  @map("last_ledger_sequence")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("finance_balance")
}

model CreditLine {
  clientId     String           @id @map("client_id") @db.Uuid
  limitCredits Int              @map("limit_credits")
  status       CreditLineStatus
  assignedAt   DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(6)
  notes        String?          @db.VarChar(1000)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("credit_line")
}

model Receipt {
  id                 String        @id @default(uuid()) @db.Uuid
  folio              BigInt        @unique @default(dbgenerated())
  clientId           String        @map("client_id") @db.Uuid
  operationType      String        @map("operation_type") @db.VarChar(80)
  operationReference String        @map("operation_reference") @db.VarChar(128)
  idempotencyKey     String        @unique @map("idempotency_key") @db.VarChar(128)
  resultSnapshot     Json          @default("{}") @map("result_snapshot")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]
  payment            Payment?
  activatedEvent     Event?

  @@index([clientId, createdAt])
  @@map("receipt")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  clientId          String          @map("client_id") @db.Uuid
  receiptId         String          @unique @map("receipt_id") @db.Uuid
  actorUserId       String          @map("actor_user_id") @db.Uuid
  provider          PaymentProvider @default(MANUAL)
  status            PaymentStatus
  amountMxnCents    BigInt          @map("amount_mxn_cents")
  currency          String          @default("MXN") @db.Char(3)
  externalReference String          @map("external_reference") @db.VarChar(160)
  idempotencyKey    String          @unique @map("idempotency_key") @db.VarChar(128)
  metadata          Json?
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  receipt           Receipt         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorUser         User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  ledgerEntries     LedgerEntry[]

  @@unique([provider, externalReference])
  @@index([clientId, createdAt])
  @@index([status, approvedAt])
  @@map("payment")
}

model LedgerEntry {
  id                              String                  @id @default(uuid()) @db.Uuid
  sequence                        BigInt                  @unique @default(autoincrement())
  clientId                        String                  @map("client_id") @db.Uuid
  eventId                         String?                 @map("event_id") @db.Uuid
  actorUserId                     String?                 @map("actor_user_id") @db.Uuid
  movementType                    LedgerMovementType      @map("movement_type")
  purchasedCreditDelta            Int                     @map("purchased_credit_delta")
  creditLineUsedDelta             Int                     @map("credit_line_used_delta")
  debtDelta                       Int                     @map("debt_delta")
  cashMxnDelta                    BigInt                  @map("cash_mxn_delta")
  creditUnitValueMxnCentsSnapshot Int?                    @map("credit_unit_value_mxn_cents_snapshot")
  currency                        String                  @default("MXN") @db.Char(3)
  operationReference              String                  @map("operation_reference") @db.VarChar(128)
  idempotencyKey                  String                  @map("idempotency_key") @db.VarChar(128)
  relatedLedgerEntryId            String?                 @map("related_ledger_entry_id") @db.Uuid
  reversesLedgerEntryId           String?                 @unique @map("reverses_ledger_entry_id") @db.Uuid
  promotionId                     String?                 @map("promotion_id") @db.Uuid
  paymentId                       String?                 @map("payment_id") @db.Uuid
  receiptId                       String                  @map("receipt_id") @db.Uuid
  dueAt                           DateTime?               @map("due_at") @db.Timestamptz(6)
  allocationMetadata              Json?                   @map("allocation_metadata")
  metadata                        Json?
  createdAt                       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  client                          Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actorUser                       User?                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  relatedLedgerEntry              LedgerEntry?            @relation("RelatedLedgerEntry", fields: [relatedLedgerEntryId], references: [id], onDelete: Restrict)
  relatedLedgerEntries            LedgerEntry[]           @relation("RelatedLedgerEntry")
  reversesLedgerEntry             LedgerEntry?            @relation("ReversedLedgerEntry", fields: [reversesLedgerEntryId], references: [id], onDelete: Restrict)
  reversedByLedgerEntry           LedgerEntry?            @relation("ReversedLedgerEntry")
  promotion                       Promotion?              @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  payment                         Payment?                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receipt                         Receipt                 @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  event                           Event?                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  debtLotAllocations              DebtPaymentAllocation[] @relation("DebtLot")
  debtPaymentAllocations          DebtPaymentAllocation[] @relation("DebtPayment")

  @@index([clientId, sequence])
  @@index([clientId, createdAt])
  @@index([movementType, createdAt])
  @@index([idempotencyKey])
  @@index([paymentId])
  @@index([receiptId])
  @@map("ledger_entry")
}

model DebtPaymentAllocation {
  id                   String      @id @default(uuid()) @db.Uuid
  debtLotLedgerEntryId String      @map("debt_lot_ledger_entry_id") @db.Uuid
  paymentLedgerEntryId String      @map("payment_ledger_entry_id") @db.Uuid
  credits              Int
  amountMxnCents       BigInt      @map("amount_mxn_cents")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  debtLotLedgerEntry   LedgerEntry @relation("DebtLot", fields: [debtLotLedgerEntryId], references: [id], onDelete: Restrict)
  paymentLedgerEntry   LedgerEntry @relation("DebtPayment", fields: [paymentLedgerEntryId], references: [id], onDelete: Restrict)

  @@unique([debtLotLedgerEntryId, paymentLedgerEntryId])
  @@index([paymentLedgerEntryId])
  @@map("debt_payment_allocation")
}

model Event {
  id                              String                 @id @default(uuid()) @db.Uuid
  clientId                        String                 @map("client_id") @db.Uuid
  createdByUserId                 String                 @map("created_by_user_id") @db.Uuid
  serviceId                       String?                @map("service_id") @db.Uuid
  name                            String?                @db.VarChar(160)
  socialType                      EventSocialType?       @map("social_type")
  status                          EventStatus            @default(DRAFT)
  eventDateTime                   DateTime?              @map("event_date_time") @db.Timestamptz(6)
  timeZone                        String?                @map("time_zone") @db.VarChar(100)
  capacity                        Int?
  confirmationEnabled             Boolean                @default(false) @map("confirmation_enabled")
  locationUrl                     String?                @map("location_url") @db.VarChar(2048)
  giftRegistryUrl                 String?                @map("gift_registry_url") @db.VarChar(2048)
  confirmationClosedAt            DateTime?              @map("confirmation_closed_at") @db.Timestamptz(6)
  confirmationClosedByUserId      String?                @map("confirmation_closed_by_user_id") @db.Uuid
  floorplanEnabled                Boolean                @default(false) @map("floorplan_enabled")
  activatedAt                     DateTime?              @map("activated_at") @db.Timestamptz(6)
  activatedByUserId               String?                @map("activated_by_user_id") @db.Uuid
  activatedServiceId              String?                @map("activated_service_id") @db.Uuid
  activatedServicePriceId         String?                @map("activated_service_price_id") @db.Uuid
  baseCostCredits                 Int?                   @map("base_cost_credits")
  promotionDiscountCredits        Int?                   @map("promotion_discount_credits")
  finalCostCredits                Int?                   @map("final_cost_credits")
  purchasedCreditsUsed            Int?                   @map("purchased_credits_used")
  creditLineCreditsUsed           Int?                   @map("credit_line_credits_used")
  creditUnitValueMxnCentsSnapshot Int?                   @map("credit_unit_value_mxn_cents_snapshot")
  activationReceiptId             String?                @unique @map("activation_receipt_id") @db.Uuid
  activationIdempotencyKey        String?                @unique @map("activation_idempotency_key") @db.VarChar(128)
  createdAt                       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  client                          Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser                   User                   @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedByUser                 User?                  @relation("EventActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  confirmationClosedByUser        User?                  @relation("EventConfirmationCloser", fields: [confirmationClosedByUserId], references: [id], onDelete: Restrict)
  service                         Service?               @relation("EventConfiguredService", fields: [serviceId], references: [id], onDelete: Restrict)
  activatedService                Service?               @relation("EventActivatedService", fields: [activatedServiceId], references: [id], onDelete: Restrict)
  activatedServicePrice           ServicePrice?          @relation(fields: [activatedServicePriceId], references: [id], onDelete: Restrict)
  activationReceipt               Receipt?               @relation(fields: [activationReceiptId], references: [id], onDelete: Restrict)
  ledgerEntries                   LedgerEntry[]
  stateOperations                 EventStateOperation[]
  contacts                        Contact[]
  groups                          Group[]
  contactImportPreviews           ContactImportPreview[]
  invitations                     Invitation[]
  assistants                      Assistant[]
  fileAssets                      FileAsset[]
  invitationDesigns               InvitationDesign[]
  staffTokens                     StaffToken[]

  @@index([clientId, status, deletedAt])
  @@index([createdByUserId, status, deletedAt])
  @@index([eventDateTime, status, deletedAt])
  @@index([activatedAt])
  @@map("event")
}

model FileAsset {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        String             @map("client_id") @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  ownerType       FileAssetOwnerType @map("owner_type")
  ownerId         String?            @map("owner_id") @db.Uuid
  fileType        FileAssetType      @map("file_type")
  storageProvider StorageProvider    @default(LOCAL) @map("storage_provider")
  storageKey      String             @unique @map("storage_key") @db.VarChar(160)
  originalName    String             @map("original_name") @db.VarChar(255)
  mimeType        String             @map("mime_type") @db.VarChar(100)
  sizeBytes       Int                @map("size_bytes")
  checksumSha256  String?            @map("checksum_sha256") @db.Char(64)
  width           Int?
  height          Int?
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  status          FileAssetStatus    @default(UPLOADING)
  failureCode     String?            @map("failure_code") @db.VarChar(80)
  associatedAt    DateTime?          @map("associated_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdByUser   User               @relation("FileAssetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  flyerInitialFor InvitationDesign[] @relation("FlyerInitialAsset")
  flyerQrFor      InvitationDesign[] @relation("FlyerQrAsset")
  flipbookPages   FlipbookPage[]

  @@index([clientId, eventId, status, deletedAt])
  @@index([eventId, ownerType, ownerId])
  @@index([status, ownerId, createdAt])
  @@map("file_asset")
}

model InvitationDesign {
  id                  String               @id @default(uuid()) @db.Uuid
  eventId             String               @map("event_id") @db.Uuid
  type                InvitationDesignType
  flyerInitialAssetId String?              @map("flyer_initial_asset_id") @db.Uuid
  flyerQrAssetId      String?              @map("flyer_qr_asset_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  flyerInitialAsset   FileAsset?           @relation("FlyerInitialAsset", fields: [flyerInitialAssetId], references: [id], onDelete: Restrict)
  flyerQrAsset        FileAsset?           @relation("FlyerQrAsset", fields: [flyerQrAssetId], references: [id], onDelete: Restrict)
  pages               FlipbookPage[]
  hotspots            Hotspot[]

  @@unique([id, eventId])
  @@index([eventId, type, deletedAt])
  @@map("invitation_design")
}

model FlipbookPage {
  id          String           @id @default(uuid()) @db.Uuid
  designId    String           @map("design_id") @db.Uuid
  eventId     String           @map("event_id") @db.Uuid
  fileAssetId String           @unique @map("file_asset_id") @db.Uuid
  position    Int
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  design      InvitationDesign @relation(fields: [designId, eventId], references: [id, eventId], onDelete: Restrict)
  fileAsset   FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  hotspots    Hotspot[]

  @@unique([id, eventId, designId])
  @@index([eventId, designId, deletedAt, position])
  @@map("flipbook_page")
}

model Hotspot {
  id              String                 @id @default(uuid()) @db.Uuid
  designId        String                 @map("design_id") @db.Uuid
  eventId         String                 @map("event_id") @db.Uuid
  visualOwnerType HotspotVisualOwnerType @map("visual_owner_type")
  flipbookPageId  String?                @map("flipbook_page_id") @db.Uuid
  action          HotspotAction
  x               Decimal                @db.Decimal(9, 8)
  y               Decimal                @db.Decimal(9, 8)
  width           Decimal                @db.Decimal(9, 8)
  height          Decimal                @db.Decimal(9, 8)
  priority        Int                    @default(0)
  url             String?                @db.VarChar(2048)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  design          InvitationDesign       @relation(fields: [designId, eventId], references: [id, eventId], onDelete: Restrict)
  flipbookPage    FlipbookPage?          @relation(fields: [flipbookPageId, eventId, designId], references: [id, eventId, designId], onDelete: Restrict)

  @@index([eventId, designId, deletedAt, priority])
  @@index([flipbookPageId, deletedAt])
  @@map("hotspot")
}

model EventStateOperation {
  id             String           @id @default(uuid()) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  action         EventStateAction
  idempotencyKey String           @unique @map("idempotency_key") @db.VarChar(128)
  resultSnapshot Json             @map("result_snapshot")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, action, createdAt])
  @@map("event_state_operation")
}

model StaffToken {
  id                String    @id @default(uuid()) @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  alias             String    @db.VarChar(80)
  tokenDigestSha256 String    @unique @map("token_digest_sha256") @db.Char(64)
  tokenVersion      Int       @default(1) @map("token_version")
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiredAt         DateTime? @map("expired_at") @db.Timestamptz(6)
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdByUser     User      @relation("StaffTokenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, expiredAt, createdAt, id])
  @@map("staff_token")
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  name           String    @db.VarChar(160)
  normalizedName String    @map("normalized_name") @db.VarChar(160)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  contacts       Contact[]

  @@unique([eventId, normalizedName])
  @@unique([id, eventId])
  @@index([eventId, createdAt])
  @@map("contact_group")
}

model Contact {
  id                      String      @id @default(uuid()) @db.Uuid
  eventId                 String      @map("event_id") @db.Uuid
  groupId                 String?     @map("group_id") @db.Uuid
  name                    String?     @db.VarChar(160)
  whatsappPhoneNormalized String?     @map("whatsapp_phone_normalized") @db.VarChar(20)
  anonymizedAt            DateTime?   @map("anonymized_at") @db.Timestamptz(6)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?   @map("deleted_at") @db.Timestamptz(6)
  event                   Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  group                   Group?      @relation(fields: [groupId, eventId], references: [id, eventId], onDelete: Restrict)
  invitation              Invitation?

  @@unique([id, eventId])
  @@index([eventId, deletedAt, createdAt])
  @@index([groupId, eventId, deletedAt])
  @@map("contact")
}

model Invitation {
  id                       String                   @id @default(uuid()) @db.Uuid
  eventId                  String                   @map("event_id") @db.Uuid
  contactId                String                   @unique @map("contact_id") @db.Uuid
  mode                     InvitationMode           @default(INDIVIDUAL)
  responseStatus           InvitationResponseStatus @default(PENDING) @map("response_status")
  additionalAssistantLimit Int                      @default(0) @map("additional_assistant_limit")
  invitationTokenNonce     String                   @unique @map("invitation_token_nonce") @db.VarChar(64)
  invitationTokenVersion   Int                      @default(1) @map("invitation_token_version")
  qrTokenNonce             String                   @unique @map("qr_token_nonce") @db.VarChar(64)
  qrTokenVersion           Int                      @default(1) @map("qr_token_version")
  cancelledAt              DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId        String?                  @map("cancelled_by_user_id") @db.Uuid
  cancelIdempotencyKey     String?                  @unique @map("cancel_idempotency_key") @db.VarChar(128)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                @map("deleted_at") @db.Timestamptz(6)
  event                    Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  contact                  Contact                  @relation(fields: [contactId, eventId], references: [id, eventId], onDelete: Restrict)
  cancelledByUser          User?                    @relation("InvitationCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  assistants               Assistant[]

  @@unique([id, eventId])
  @@unique([contactId, eventId])
  @@index([eventId, deletedAt, createdAt])
  @@index([cancelledAt])
  @@map("invitation")
}

model Assistant {
  id             String                  @id @default(uuid()) @db.Uuid
  eventId        String                  @map("event_id") @db.Uuid
  invitationId   String                  @map("invitation_id") @db.Uuid
  name           String?                 @db.VarChar(160)
  isPrimary      Boolean                 @default(false) @map("is_primary")
  responseStatus AssistantResponseStatus @default(PENDING) @map("response_status")
  anonymizedAt   DateTime?               @map("anonymized_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?               @map("deleted_at") @db.Timestamptz(6)
  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  invitation     Invitation              @relation(fields: [invitationId, eventId], references: [id, eventId], onDelete: Restrict)

  @@index([invitationId, deletedAt, createdAt])
  @@index([eventId, deletedAt])
  @@map("assistant")
}

model ContactImportPreview {
  id                   String    @id @default(uuid()) @db.Uuid
  eventId              String    @map("event_id") @db.Uuid
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  totalRows            Int       @map("total_rows")
  validRows            Int       @map("valid_rows")
  invalidRows          Int       @map("invalid_rows")
  normalizedRows       Json?     @map("normalized_rows")
  committedAt          DateTime? @map("committed_at") @db.Timestamptz(6)
  commitIdempotencyKey String?   @unique @map("commit_idempotency_key") @db.VarChar(128)
  resultSnapshot       Json?     @map("result_snapshot")
  piiPurgedAt          DateTime? @map("pii_purged_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdByUser        User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, expiresAt])
  @@index([expiresAt, committedAt])
  @@map("contact_import_preview")
}
